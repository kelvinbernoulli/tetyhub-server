# Core server configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379
DB_USER_NAME=postgres
DB_HOST=localhost
DB_NAME=tetyhub
DB_PASSWORD=change-me
DB_PORT=5432
# Set false only when the PostgreSQL connection should not use TLS.
# TLS is enabled by default, with certificate verification disabled.
DB_SSL=false
# Set to the actual proxy hop count or trusted proxy addresses in deployment.
TRUST_PROXY=0
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_DEV_URL=http://localhost:3000
FRONTEND_URL=https://example.com
OTP_EXPIRATION=600

# Admin invitations
ADMIN_INVITE_URL=https://example.com/admin/invitations/accept
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# One-time bootstrap values. Remove SUPER_ADMIN_PASSWORD from the runtime
# environment after running `npm run bootstrap:super-admin`.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=Admin

# Checkout shipping: approved major-unit fees by currency and exact country name.
CHECKOUT_SHIPPING_RATES={}
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# Subscription renewal email delivery uses the application SMTP transport.
MAILER_HOST=
MAILER_PORT=2525
MAILER_USER=
MAILER_PASSWORD=
MAIL_SECURE=false
EMAIL_USER=

# Optional disposable PostgreSQL databases for integration tests only.
CHECKOUT_DATABASE_URL=
BOOKING_DATABASE_URL=
