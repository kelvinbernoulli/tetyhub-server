# Admin invitations
ADMIN_INVITE_URL=https://example.com/admin/invitations/accept
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# One-time bootstrap values. Remove SUPER_ADMIN_PASSWORD from the runtime
# environment after running `npm run bootstrap:super-admin`.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=Admin
