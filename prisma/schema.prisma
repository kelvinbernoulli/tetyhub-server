// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER     @map("customer")
  VENDOR       @map("vendor")
  ADMIN        @map("admin")
  VENDOR_ADMIN @map("vendor_admin")
  SUPER_ADMIN  @map("super_admin")
}

enum UserStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
}

enum AdminScope {
  PLATFORM @map("platform")
  VENDOR   @map("vendor")
}

enum AdminStatus {
  INVITED   @map("invited")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")
}

enum PermissionScope {
  PLATFORM @map("platform")
  VENDOR   @map("vendor")
  BOTH     @map("both")
}

enum CategoryType {
  PRODUCT @map("product")
  SERVICE @map("service")
  BOTH    @map("both")
}

// ===============================================
// USERS & AUTHENTICATION
// ===============================================

model users {
  coupon_usage             coupon_usage[]
  changed_order_statuses   order_status_history[]
  id                       Int                    @id @default(autoincrement())
  firstname                String?
  lastname                 String?
  email                    String                 @unique
  password                 String
  phone                    String?                @unique
  country_id               Int?
  role                     UserRole               @default(CUSTOMER)
  google_id                String?                @unique
  status                   UserStatus             @default(ACTIVE)
  email_verified           Boolean                @default(false)
  email_verification_token String?
  email_verified_at        DateTime?
  legacy_admin_roles       String[]               @default([]) @map("admin_role")
  auth_version             Int                    @default(1)
  created_at               DateTime               @default(now())
  updated_at               DateTime?              @updatedAt

  // Relations
  country                   countries?               @relation(fields: [country_id], references: [id])
  user_info                 users_info?
  vendors                   vendors?
  orders                    orders[]
  payments                  payments[]
  carts                     carts[]
  wishlists                 wishlist_items[]
  reviews                   reviews[]
  returns                   returns[]
  notifications             notifications[]
  activity_logs             activity_logs[]
  support_tickets           support_tickets[]
  support_ticket_replies    support_ticket_replies[]
  shipping_addresses        shipping_addresses[]
  admin                     admins?                  @relation("AdminUser")
  admin_assignments_created admins[]                 @relation("AdminCreatedBy")
  permission_grants_created admin_permissions[]      @relation("PermissionGrantedBy")
  admin_audit_logs          admin_audit_logs[]       @relation("AdminAuditActor")
  service_bookings          service_bookings[]

  @@index([country_id])
}

model users_info {
  id          Int       @id @default(autoincrement())
  user_id     Int       @unique
  avatar      String?
  phone       String?
  address     String?
  city        String?
  state       String?
  postal_code String?
  country     String?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ===============================================
// VENDORS & ADMIN
// ===============================================

model vendors {
  id                  Int       @id @default(autoincrement())
  user_id             Int       @unique
  store_name          String?
  store_slug          String?   @unique
  description         String?
  logo                String?
  banner              String?
  phone_one           String?
  phone_two           String?
  facebook            String?
  twitter             String?
  instagram           String?
  linkedIn            String?
  snapchat            String?
  whatsapp            String?
  email               String?
  website             String?
  address             String?
  city                String?
  state               String?
  postal_code         String?
  country_id          Int?
  verification_status String    @default("pending") // pending, verified, rejected
  commission_rate     Float     @default(0)
  status              String    @default("active") // active, inactive, suspended
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt

  // Relations
  user             users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country          countries?         @relation(fields: [country_id], references: [id])
  products         products[]
  order_items      order_items[]
  product_images   product_images[]
  product_variants product_variants[]
  payments         payments[]
  coupons          coupons[]
  support_tickets  support_tickets[]
  returns          returns[]
  vendor_settings  vendor_settings?
  admins           admins[]
  admin_audit_logs admin_audit_logs[]
  services         services[]
  service_bookings service_bookings[]

  @@index([country_id])
}

model admins {
  id                    Int         @id @default(autoincrement())
  user_id               Int         @unique
  vendor_id             Int?
  legacy_role           String      @default("admin") @map("role")
  scope                 AdminScope  @default(PLATFORM)
  status                AdminStatus @default(INVITED)
  authz_version         Int         @default(1)
  created_by_user_id    Int?
  invitation_token_hash String?     @unique
  invitation_expires_at DateTime?
  invited_at            DateTime    @default(now())
  activated_at          DateTime?
  revoked_at            DateTime?
  created_at            DateTime    @default(now())
  updated_at            DateTime?   @updatedAt

  // Relations
  user        users               @relation("AdminUser", fields: [user_id], references: [id], onDelete: Cascade)
  vendor      vendors?            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  created_by  users?              @relation("AdminCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  permissions admin_permissions[]
  audit_logs  admin_audit_logs[]

  @@index([scope, status])
  @@index([vendor_id, status])
}

model admin_types {
  id          Int             @id @default(autoincrement())
  admin_type  String          @unique
  slug        String          @unique
  description String?
  scope       PermissionScope @default(BOTH)
  is_system   Boolean         @default(false)
  status      Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime?       @updatedAt

  // Relations
  permissions admin_permissions[]
}

model admin_permissions {
  id                 Int       @id @default(autoincrement())
  admin_id           Int
  admin_type_id      Int
  can_create         Boolean   @default(false)
  can_read           Boolean   @default(true)
  can_update         Boolean   @default(false)
  can_delete         Boolean   @default(false)
  status             Boolean   @default(false)
  granted_by_user_id Int?
  expires_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime? @updatedAt

  // Relations
  admin      admins      @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  admin_type admin_types @relation(fields: [admin_type_id], references: [id], onDelete: Cascade)
  granted_by users?      @relation("PermissionGrantedBy", fields: [granted_by_user_id], references: [id], onDelete: SetNull)

  @@unique([admin_id, admin_type_id])
  @@index([expires_at])
}

model admin_audit_logs {
  id              Int      @id @default(autoincrement())
  actor_user_id   Int
  target_admin_id Int?
  vendor_id       Int?
  action          String
  outcome         String   @default("success")
  changes         Json?
  request_id      String?
  ip_address      String?
  user_agent      String?
  created_at      DateTime @default(now())

  actor        users    @relation("AdminAuditActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  target_admin admins?  @relation(fields: [target_admin_id], references: [id], onDelete: SetNull)
  vendor       vendors? @relation(fields: [vendor_id], references: [id], onDelete: SetNull)

  @@index([actor_user_id, created_at])
  @@index([target_admin_id, created_at])
  @@index([vendor_id, created_at])
}

model categories {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  type        CategoryType @default(PRODUCT)
  description String?
  image       String?
  status      Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime?    @updatedAt

  // Relations
  subcategories subcategories[]
  products      products[]
  services      services[]
}

model subcategories {
  id          Int       @id @default(autoincrement())
  category_id Int
  name        String
  slug        String
  description String?
  image       String?
  status      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  category      categories        @relation(fields: [category_id], references: [id], onDelete: Cascade)
  childcategory childcategories[]
  products      products[]
  services      services[]

  @@unique([category_id, slug])
}

model childcategories {
  id             Int       @id @default(autoincrement())
  subcategory_id Int
  name           String
  slug           String
  description    String?
  image          String?
  status         Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt

  // Relations
  subcategory subcategories @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)
  products    products[]
  services    services[]

  @@unique([subcategory_id, slug])
}

model products {
  id                  Int       @id @default(autoincrement())
  vendor_id           Int
  category_id         Int
  subcategory_id      Int?
  childcategory_id    Int?
  name                String
  sku                 String?
  barcode             String?
  slug                String
  description         String?
  short_description   String?
  brand               String?
  tags                String[]  @default([])
  price               Decimal   @db.Decimal(10, 2)
  compare_at_price    Decimal?  @db.Decimal(10, 2)
  cost_price          Decimal?  @db.Decimal(10, 2)
  discount            Float     @default(0)
  stock               Int       @default(0)
  low_stock_threshold Int       @default(10)
  track_inventory     Boolean   @default(true)
  has_variants        Boolean   @default(false)
  thumbnail           String?
  weight              Float?
  length              Float?
  width               Float?
  height              Float?
  free_shipping       Boolean   @default(false)
  status              String    @default("draft") // draft, active, archived
  is_featured         Boolean   @default(false)
  is_digital          Boolean   @default(false)
  meta_title          String?
  meta_description    String?
  currency_id         Int
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt
  deleted_at          DateTime?

  // Relations
  vendor         vendors              @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  category       categories           @relation(fields: [category_id], references: [id])
  subcategory    subcategories?       @relation(fields: [subcategory_id], references: [id])
  childcategory  childcategories?     @relation(fields: [childcategory_id], references: [id])
  currency       currencies           @relation(fields: [currency_id], references: [id])
  images         product_images[]
  variants       product_variants[]
  attributes     product_attributes[]
  options        product_options[]
  cart_items     cart_items[]
  order_items    order_items[]
  reviews        reviews[]
  wishlist_items wishlist_items[]
  coupons        coupons[]

  @@index([currency_id])
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int
  vendor_id  Int
  url        String
  alt_text   String?
  position   Int       @default(0)
  is_primary Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vendor  vendors  @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model product_variants {
  id                  Int       @id @default(autoincrement())
  product_id          Int
  vendor_id           Int
  name                String?
  sku                 String?
  barcode             String?
  price               Decimal   @db.Decimal(10, 2)
  compare_at_price    Decimal?  @db.Decimal(10, 2)
  cost_price          Decimal?  @db.Decimal(10, 2)
  stock               Int       @default(0)
  low_stock_threshold Int       @default(5)
  image               String?
  weight              Float?
  dimensions          String?
  status              String    @default("active")
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt

  // Relations
  product       products                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vendor        vendors                 @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  cart_items    cart_items[]
  order_items   order_items[]
  option_values variant_option_values[]
}

model product_attributes {
  id         Int      @id @default(autoincrement())
  product_id Int
  name       String
  value      String
  position   Int      @default(0)
  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model product_options {
  id         Int                     @id @default(autoincrement())
  product_id Int
  name       String
  position   Int                     @default(0)
  product    products                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  values     product_option_values[]

  @@index([product_id])
}

model product_option_values {
  id        Int                     @id @default(autoincrement())
  option_id Int
  value     String
  position  Int                     @default(0)
  option    product_options         @relation(fields: [option_id], references: [id], onDelete: Cascade)
  variants  variant_option_values[]

  @@index([option_id])
}

model variant_option_values {
  variant_id      Int
  option_value_id Int
  variant         product_variants      @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  option_value    product_option_values @relation(fields: [option_value_id], references: [id], onDelete: Cascade)

  @@id([variant_id, option_value_id])
  @@index([option_value_id])
}

// ===============================================
// SHOPPING CART & WISHLISTS
// ===============================================

model carts {
  id          Int       @id @default(autoincrement())
  user_id     Int       @unique
  total_items Int       @default(0)
  subtotal    Decimal   @default(0) @db.Decimal(10, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  user  users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items cart_items[]
}

model cart_items {
  id          Int       @id @default(autoincrement())
  cart_id     Int
  product_id  Int
  variant_id  Int?
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  currency_id Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  cart     carts             @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product  products          @relation(fields: [product_id], references: [id])
  variant  product_variants? @relation(fields: [variant_id], references: [id])
  currency currencies?       @relation(fields: [currency_id], references: [id])

  @@index([variant_id])
}

model wishlist_items {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())

  // Relations
  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id]) // Keeps entries unique per user
  @@map("wishlist_items")
}

// ===============================================
// ORDERS & PAYMENTS
// ===============================================

model orders {
  id                     Int       @id @default(autoincrement())
  currency_id            Int
  user_id                Int
  order_number           String    @unique
  subtotal               Decimal   @db.Decimal(10, 2)
  shipping_fee           Decimal   @default(0) @db.Decimal(10, 2)
  tax                    Decimal   @default(0) @db.Decimal(10, 2)
  discount               Decimal   @default(0) @db.Decimal(10, 2)
  total                  Decimal   @db.Decimal(10, 2)
  note                   String?
  coupon_id              Int?
  coupon_code            String?
  status                 String    @default("pending")
  payment_status         String    @default("unpaid")
  payment_method         String?
  shipping_address       Json?
  billing_address        Json?
  checkout_key           String?
  checkout_hash          String?
  contact_email          String?
  reservation_expires_at DateTime? @default(dbgenerated("(now() + interval '30 minutes')"))
  created_at             DateTime  @default(now())
  updated_at             DateTime? @updatedAt

  // Relations
  user                  users                   @relation(fields: [user_id], references: [id])
  coupon                coupons?                @relation(fields: [coupon_id], references: [id])
  items                 order_items[]
  payments              payments[]
  shipments             shipments[]
  returns               returns[]
  shipping_addresses    shipping_addresses[]
  currency              currencies?             @relation(fields: [currency_id], references: [id])
  coupon_usage          coupon_usage?
  status_history        order_status_history[]
  checkout_notification checkout_notifications?

  @@unique([user_id, checkout_key])
  @@index([user_id, status])
  @@index([created_at])
  @@index([coupon_id])
}

model order_items {
  id             Int       @id @default(autoincrement())
  order_id       Int       @map("order_id")
  product_id     Int?      @map("product_id") // Nullable if the line is a service
  service_id     Int?      @map("service_id") // Nullable if the line is a product
  variant_id     Int?      @map("variant_id") // Nullable if no product variant exists
  vendor_id      Int       @map("vendor_id")
  quantity       Int
  stock_reserved Boolean   @default(false)
  price          Decimal   @db.Decimal(10, 2)
  subtotal       Decimal   @db.Decimal(10, 2)
  created_at     DateTime  @default(now()) @map("created_at")
  updated_at     DateTime? @updatedAt @map("updated_at")

  // 🌟 Cleaned, Compilable Relations
  order        orders            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product      products?         @relation(fields: [product_id], references: [id]) // Made optional
  service      services?         @relation(fields: [service_id], references: [id]) // Corrected single mapping
  variant      product_variants? @relation(fields: [variant_id], references: [id])
  vendor       vendors           @relation(fields: [vendor_id], references: [id])
  return_items return_items[]

  // Performance Compound Indexes
  @@index([order_id])
  @@index([product_id])
  @@index([service_id])
  @@index([variant_id])
  @@index([vendor_id])
  @@map("order_items")
}

model shipping_addresses {
  country_id Int?
  id         Int       @id @default(autoincrement())
  order_id   Int
  user_id    Int
  firstname  String
  lastname   String
  phone_one  String
  phone_two  String?
  address    String
  city       String
  state      String
  country    String
  zip_code   String?
  is_default Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  user   users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model payments {
  events             payment_events[]
  provider_ref       String?          @unique
  checkout_data      String?
  initializing_until DateTime?
  paid_at            DateTime?
  id                 Int              @id @default(autoincrement())
  order_id           Int?
  user_id            Int
  vendor_id          Int?
  gateway            String // paystack, stripe, etc
  gateway_ref        String           @unique
  amount             Decimal          @db.Decimal(10, 2)
  currency_id        Int
  status             String           @default("pending") // pending, completed, failed
  meta               String? // JSON metadata
  created_at         DateTime         @default(now())
  updated_at         DateTime?        @updatedAt

  // Relations
  order  orders?  @relation(fields: [order_id], references: [id])
  user   users    @relation(fields: [user_id], references: [id])
  vendor vendors? @relation(fields: [vendor_id], references: [id])
}

model coupons {
  usage        coupon_usage[]
  id           Int            @id @default(autoincrement())
  vendor_id    Int
  product_id   Int?
  service_id   Int?
  code         String
  type         String // percentage, fixed_amount
  value        Decimal        @db.Decimal(10, 2)
  max_discount Decimal?       @db.Decimal(10, 2)
  min_order    Decimal        @default(0) @db.Decimal(10, 2)
  usage_limit  Int?
  usage_count  Int            @default(0)
  status       String         @default("active")
  expires_at   DateTime?
  description  String?
  created_at   DateTime       @default(now())
  updated_at   DateTime?      @updatedAt

  // Relations
  vendor  vendors   @relation(fields: [vendor_id], references: [id])
  product products? @relation(fields: [product_id], references: [id])
  service services? @relation(fields: [service_id], references: [id])
  orders  orders[]

  @@unique([vendor_id, code])
  @@index([status, expires_at])
}

// ===============================================
// SHIPMENTS & RETURNS
// ===============================================

model shipments {
  id                 Int       @id @default(autoincrement())
  order_id           Int       @unique
  tracking_number    String?
  carrier            String?
  shipping_method    String?
  estimated_delivery DateTime?
  actual_delivery    DateTime?
  shipping_cost      Decimal   @default(0) @db.Decimal(10, 2)
  status             String    @default("pending") // pending, processing, shipped, in_transit, delivered
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime? @updatedAt

  // Relations
  order            orders                      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  tracking_history shipment_tracking_history[]
}

model shipment_tracking_history {
  id          Int       @id @default(autoincrement())
  shipment_id Int
  status      String
  location    String?
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  shipment shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
}

model returns {
  id            Int       @id @default(autoincrement())
  order_id      Int
  user_id       Int
  vendor_id     Int?
  reason        String
  description   String?
  return_type   String // full, partial, exchange
  refund_amount Decimal   @default(0) @db.Decimal(10, 2)
  status        String    @default("pending") // pending, approved, rejected, shipped, received, completed
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  // Relations
  order  orders         @relation(fields: [order_id], references: [id])
  user   users          @relation(fields: [user_id], references: [id])
  vendor vendors?       @relation(fields: [vendor_id], references: [id])
  items  return_items[]
}

model return_items {
  id            Int       @id @default(autoincrement())
  return_id     Int
  order_item_id Int
  quantity      Int
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  // Relations
  return     returns     @relation(fields: [return_id], references: [id], onDelete: Cascade)
  order_item order_items @relation(fields: [order_item_id], references: [id])

  @@index([order_item_id])
}

// ===============================================
// REVIEWS & RATINGS
// ===============================================

model reviews {
  id                Int       @id @default(autoincrement())
  product_id        Int?
  service_id        Int?
  user_id           Int
  order_id          Int?
  rating            Int       @default(5)
  title             String?
  comment           String?
  status            String    @default("pending") // pending, approved, rejected
  verified_purchase Boolean   @default(false)
  helpful_count     Int       @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt

  // Relations
  product products? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  service services? @relation(fields: [service_id], references: [id], onDelete: Cascade)
  user    users     @relation(fields: [user_id], references: [id])
}

// ===============================================
// SUPPORT & NOTIFICATIONS
// ===============================================

model support_tickets {
  id            Int       @id @default(autoincrement())
  ticket_number String    @unique
  subject       String
  category      String?
  priority      String    @default("normal") // low, normal, high, urgent
  status        String    @default("open") // open, in_progress, resolved, closed, reopened
  user_id       Int?
  vendor_id     Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  // Relations
  user    users?                   @relation(fields: [user_id], references: [id])
  vendor  vendors?                 @relation(fields: [vendor_id], references: [id])
  replies support_ticket_replies[]
}

model support_ticket_replies {
  id         Int       @id @default(autoincrement())
  ticket_id  Int
  user_id    Int
  message    String
  attachment String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  ticket support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   users           @relation(fields: [user_id], references: [id])
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String // order, payment, return, shipment, etc
  title      String
  message    String
  metadata   String? // JSON data
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model activity_logs {
  id         Int      @id @default(autoincrement())
  user_id    Int
  action     String
  details    String? // JSON data
  created_at DateTime @default(now())

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ===============================================
// SETTINGS
// ===============================================

model vendor_settings {
  id                   Int       @id @default(autoincrement())
  vendor_id            Int       @unique
  site_name            String?
  phone_one            String?
  phone_two            String?
  email                String?
  twitter              String?
  instagram            String?
  linkedIn             String?
  snapchat             String?
  terms_and_conditions String?
  privacy_policy       String?
  created_at           DateTime  @default(now())
  updated_at           DateTime? @updatedAt

  // Relations
  vendor vendors @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

// ===============================================
// REFERENCE DATA
// ===============================================

model countries {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  currency_id Int
  status      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  users    users[]
  vendors  vendors[]
  currency currencies @relation(fields: [currency_id], references: [id], onDelete: Cascade)
}

model currencies {
  orders     orders[]
  id         Int       @id @default(autoincrement())
  code       String    @unique
  name       String
  status     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  products  products[]
  countries countries[]
  cartItems cart_items[]
  services  services[]
}

model services {
  id            Int       @id @default(autoincrement())
  vendor_id     Int       @map("vendor_id")
  name          String
  slug          String    @unique
  description   String?
  base_price    Decimal   @map("base_price") @db.Decimal(10, 2)
  currency_id   Int       @map("currency_id")
  duration_mins Int       @default(60) @map("duration_mins")
  status        String    @default("active") // active, paused, deleted
  created_at    DateTime  @default(now()) @map("created_at")
  updated_at    DateTime? @updatedAt @map("updated_at")

  // Relations
  vendor                    vendors            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  orderItems                order_items[]
  bookings                  service_bookings[]
  reviews                   reviews[]
  currency                  currencies         @relation(fields: [currency_id], references: [id], onDelete: Cascade)
  coupons                   coupons[]
  category_id               Int?
  subcategory_id            Int?
  childcategory_id          Int?
  short_description         String?
  tags                      String[]           @default([])
  compare_at_price          Decimal?           @db.Decimal(10, 2)
  buffer_mins               Int                @default(0)
  max_bookings_per_slot     Int                @default(1)
  is_remote                 Boolean            @default(false)
  location_type             String             @default("vendor_location")
  cancellation_window_hours Int                @default(24)
  cancellation_fee_percent  Float              @default(0)
  images                    String[]           @default([])
  thumbnail                 String?
  meta_title                String?
  meta_description          String?
  deleted_at                DateTime?

  category      categories?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  subcategory   subcategories?   @relation(fields: [subcategory_id], references: [id], onDelete: SetNull)
  childcategory childcategories? @relation(fields: [childcategory_id], references: [id], onDelete: SetNull)

  @@index([vendor_id, status])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([childcategory_id])
  @@map("services")
}

model service_bookings {
  id                        Int       @id @default(autoincrement())
  service_id                Int       @map("service_id")
  vendor_id                 Int       @map("vendor_id")
  user_id                   Int       @map("user_id")
  currency_id               Int       @map("currency_id")
  service_name              String
  total                     Decimal?  @db.Decimal(10, 2)
  payment_method            String
  payment_status            String    @default("unpaid") // unpaid, paid, refunded
  ends_at                   DateTime?
  buffer_mins               Int       @default(0) @map("buffer_mins")
  location_type             String
  location                  String    @map("location")
  checkout_key              String    @map("checkout_key")
  checkout_hash             String    @map("checkout_hash")
  scheduled_for             DateTime  @map("scheduled_for")
  cancellation_window_hours Int       @default(24) @map("cancellation_window_hours")
  cancellation_fee_percent  Float     @default(0) @map("cancellation_fee_percent")
  reservation_expires_at    DateTime? @default(dbgenerated("(now() + interval '30 minutes')")) @map("reservation_expires_at")
  created_at                DateTime  @default(now()) @map("created_at")
  booking_status            String    @default("pending") @map("booking_status") // pending, confirmed, active, completed, cancelled
  note                      String?   @map("note")

  // Relations
  service services @relation(fields: [service_id], references: [id]) // Linked safely here
  user    users    @relation(fields: [user_id], references: [id])
  vendors vendors   @relation(fields: [vendor_id], references: [id])

  @@index([service_id, booking_status])
  @@map("service_bookings")
}

model coupon_usage {
  coupon    coupons @relation(fields: [coupon_id], references: [id])
  user      users   @relation(fields: [user_id], references: [id])
  order     orders  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  id        Int     @id @default(autoincrement())
  coupon_id Int
  user_id   Int
  order_id  Int     @unique

  @@unique([coupon_id, user_id])
}

model order_status_history {
  id         Int      @id @default(autoincrement())
  order_id   Int
  status     String
  note       String?
  changed_by Int?
  created_at DateTime @default(now())

  order           orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  changed_by_user users? @relation(fields: [changed_by], references: [id])

  @@index([order_id, created_at])
}

model payment_events {
  payment          payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  id               Int      @id @default(autoincrement())
  payment_id       Int
  gateway          String
  gateway_event_id String
  event_type       String
  created_at       DateTime @default(now())

  @@unique([gateway, gateway_event_id])
}

model checkout_notifications {
  id           Int       @id @default(autoincrement())
  order_id     Int       @unique
  attempts     Int       @default(0)
  available_at DateTime  @default(now())
  delivered_at DateTime?

  order orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
}
