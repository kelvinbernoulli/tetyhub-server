// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER     @map("customer")
  VENDOR       @map("vendor")
  ADMIN        @map("admin")
  VENDOR_ADMIN @map("vendor_admin")
  SUPER_ADMIN  @map("super_admin")
}

enum UserStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
}

enum AdminScope {
  PLATFORM @map("platform")
  VENDOR   @map("vendor")
}

enum AdminStatus {
  INVITED   @map("invited")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")
}

enum PermissionScope {
  PLATFORM @map("platform")
  VENDOR   @map("vendor")
  BOTH     @map("both")
}

enum CategoryType {
  PRODUCT @map("product")
  SERVICE @map("service")
  BOTH    @map("both")
}

enum SubscriptionPlan {
  FREE     @map("FREE")
  PRO      @map("PRO")
  BUSINESS @map("BUSINESS")
}

enum SubscriptionStatus {
  TRIALING  @map("trialing")
  ACTIVE    @map("active")
  PAST_DUE  @map("past_due")
  CANCELLED @map("cancelled")
}

enum PlanAnalytics {
  NONE  @map("none")
  BASIC @map("basic")
  FULL  @map("full")
}

enum PlanSupport {
  STANDARD @map("standard")
  PRIORITY @map("priority")
}

// ===============================================
// USERS & AUTHENTICATION
// ===============================================

model users {
  coupon_usage             coupon_usage[]
  commission_settings_updated platform_commission_settings[] @relation("CommissionSettingsUpdater")
  commission_changes        platform_commission_settings_history[] @relation("CommissionHistoryActor")
  changed_order_statuses   order_status_history[]
  id                       Int                    @id @default(autoincrement())
  firstname                String?
  lastname                 String?
  email                    String                 @unique
  password                 String
  phone                    String?                @unique
  country_id               Int?
  role                     UserRole               @default(CUSTOMER)
  google_id                String?                @unique
  status                   UserStatus             @default(ACTIVE)
  email_verified           Boolean                @default(false)
  email_verification_token String?
  email_verified_at        DateTime?
  legacy_admin_roles       String[]               @default([]) @map("admin_role")
  auth_version             Int                    @default(1)
  created_at               DateTime               @default(now())
  updated_at               DateTime?              @updatedAt

  // Relations
  country                   countries?               @relation(fields: [country_id], references: [id])
  user_info                 users_info?
  vendors                   vendors?
  orders                    orders[]
  payments                  payments[]
  carts                     carts[]
  wishlists                 wishlist_items[]
  reviews                   reviews[]
  returns                   returns[]
  notifications             notifications[]
  activity_logs             activity_logs[]
  support_tickets           support_tickets[]
  support_ticket_replies    support_ticket_replies[]
  assigned_support_tickets  support_tickets[]        @relation("SupportAssignee")
  pending_support_transfers support_tickets[]        @relation("SupportTransferTarget")
  requested_support_transfers support_tickets[]      @relation("SupportTransferRequester")
  shipping_addresses        shipping_addresses[]
  admin                     admins?                  @relation("AdminUser")
  admin_assignments_created admins[]                 @relation("AdminCreatedBy")
  permission_grants_created admin_permissions[]      @relation("PermissionGrantedBy")
  admin_audit_logs          admin_audit_logs[]       @relation("AdminAuditActor")
  service_bookings          service_bookings[]
  vendorSettings            vendor_settings?

  @@index([country_id])
}

model users_info {
  id          Int       @id @default(autoincrement())
  user_id     Int       @unique
  avatar      String?
  phone       String?
  gender      String?
  dob         String?
  address     String?
  city        String?
  state       String?
  postal_code String?
  country     String?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ===============================================
// VENDORS & ADMIN
// ===============================================

model vendors {
  shipments shipments[]
  order_fulfillments vendor_order_fulfillments[]
  marketplace_ledger_entries marketplace_ledger_entries[]
  subscription         Subscription?
  subscription_events  SubscriptionEvent[]
  id                  Int       @id @default(autoincrement())
  user_id             Int       @unique
  verification_status String    @default("pending") // pending, verified, rejected
  status              String    @default("active") // active, inactive, suspended
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt

  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products         products[]
  order_items      order_items[]
  product_images   product_images[]
  product_variants product_variants[]
  payments         payments[]
  coupons          coupons[]
  support_tickets  support_tickets[]
  returns          returns[]
  admins           admins[]
  admin_audit_logs admin_audit_logs[]
  services         services[]
  service_bookings service_bookings[]
  vendorSettings   vendor_settings?
}

model admins {
  id                    Int         @id @default(autoincrement())
  user_id               Int         @unique
  vendor_id             Int?
  legacy_role           String      @default("admin") @map("role")
  scope                 AdminScope  @default(PLATFORM)
  status                AdminStatus @default(INVITED)
  authz_version         Int         @default(1)
  created_by_user_id    Int?
  invitation_token_hash String?     @unique
  invitation_expires_at DateTime?
  invited_at            DateTime    @default(now())
  activated_at          DateTime?
  revoked_at            DateTime?
  created_at            DateTime    @default(now())
  updated_at            DateTime?   @updatedAt

  // Relations
  user              users               @relation("AdminUser", fields: [user_id], references: [id], onDelete: Cascade)
  vendor            vendors?            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  created_by        users?              @relation("AdminCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  permissions       admin_permissions[]
  audit_logs        admin_audit_logs[]
  vendorSettings    vendor_settings?    @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  @@index([scope, status])
  @@index([vendor_id, status])
}

model admin_types {
  id          Int             @id @default(autoincrement())
  admin_type  String          @unique
  slug        String          @unique
  description String?
  scope       PermissionScope @default(BOTH)
  is_system   Boolean         @default(false)
  status      Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime?       @updatedAt

  // Relations
  permissions admin_permissions[]
}

model admin_permissions {
  id                 Int       @id @default(autoincrement())
  admin_id           Int
  admin_type_id      Int
  can_create         Boolean   @default(false)
  can_read           Boolean   @default(true)
  can_update         Boolean   @default(false)
  can_delete         Boolean   @default(false)
  status             Boolean   @default(false)
  granted_by_user_id Int?
  expires_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime? @updatedAt

  // Relations
  admin      admins      @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  admin_type admin_types @relation(fields: [admin_type_id], references: [id], onDelete: Cascade)
  granted_by users?      @relation("PermissionGrantedBy", fields: [granted_by_user_id], references: [id], onDelete: SetNull)

  @@unique([admin_id, admin_type_id])
  @@index([expires_at])
}

model admin_audit_logs {
  id              Int      @id @default(autoincrement())
  actor_user_id   Int
  target_admin_id Int?
  vendor_id       Int?
  action          String
  outcome         String   @default("success")
  changes         Json?
  request_id      String?
  ip_address      String?
  user_agent      String?
  created_at      DateTime @default(now())

  actor             users            @relation("AdminAuditActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  target_admin      admins?          @relation(fields: [target_admin_id], references: [id], onDelete: SetNull)
  vendor            vendors?         @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  vendorSettings    vendor_settings? @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  @@index([actor_user_id, created_at])
  @@index([target_admin_id, created_at])
  @@index([vendor_id, created_at])
}

model categories {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  type        CategoryType @default(PRODUCT)
  description String?
  image       String?
  status      Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime?    @updatedAt

  // Relations
  subcategories subcategories[]
  products      products[]
  services      services[]
}

model subcategories {
  id          Int       @id @default(autoincrement())
  category_id Int
  name        String
  slug        String
  description String?
  image       String?
  status      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  category      categories        @relation(fields: [category_id], references: [id], onDelete: Cascade)
  childcategory childcategories[]
  products      products[]
  services      services[]

  @@unique([category_id, slug])
}

model childcategories {
  id             Int       @id @default(autoincrement())
  subcategory_id Int
  name           String
  slug           String
  description    String?
  image          String?
  status         Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt

  // Relations
  subcategory subcategories @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)
  products    products[]
  services    services[]

  @@unique([subcategory_id, slug])
}

model products {
  id                  Int       @id @default(autoincrement())
  vendor_id           Int
  category_id         Int
  subcategory_id      Int?
  childcategory_id    Int?
  name                String
  sku                 String?
  barcode             String?
  slug                String
  description         String?
  short_description   String?
  brand               String?
  tags                String[]  @default([])
  price               Decimal   @db.Decimal(10, 2)
  compare_at_price    Decimal?  @db.Decimal(10, 2)
  cost_price          Decimal?  @db.Decimal(10, 2)
  discount            Float     @default(0)
  stock               Int       @default(0)
  low_stock_threshold Int       @default(10)
  track_inventory     Boolean   @default(true)
  has_variants        Boolean   @default(false)
  thumbnail           String?
  weight              Float?
  length              Float?
  width               Float?
  height              Float?
  free_shipping       Boolean   @default(false)
  status              String    @default("draft") // draft, active, archived
  is_featured         Boolean   @default(false)
  is_digital          Boolean   @default(false)
  meta_title          String?
  meta_description    String?
  currency_id         Int
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt
  deleted_at          DateTime?

  // Relations
  vendor            vendors              @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  category          categories           @relation(fields: [category_id], references: [id])
  subcategory       subcategories?       @relation(fields: [subcategory_id], references: [id])
  childcategory     childcategories?     @relation(fields: [childcategory_id], references: [id])
  currency          currencies           @relation(fields: [currency_id], references: [id])
  images            product_images[]
  variants          product_variants[]
  attributes        product_attributes[]
  options           product_options[]
  cart_items        cart_items[]
  order_items       order_items[]
  reviews           reviews[]
  wishlist_items    wishlist_items[]
  coupons           coupons[]
  vendorSettings    vendor_settings?     @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  @@index([currency_id])
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int
  vendor_id  Int
  url        String
  alt_text   String?
  position   Int       @default(0)
  is_primary Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  product           products         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vendor            vendors          @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  vendorSettings    vendor_settings? @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?
}

model product_variants {
  id                  Int       @id @default(autoincrement())
  product_id          Int
  vendor_id           Int
  name                String?
  sku                 String?
  barcode             String?
  price               Decimal   @db.Decimal(10, 2)
  compare_at_price    Decimal?  @db.Decimal(10, 2)
  cost_price          Decimal?  @db.Decimal(10, 2)
  stock               Int       @default(0)
  low_stock_threshold Int       @default(5)
  image               String?
  weight              Float?
  dimensions          String?
  status              String    @default("active")
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt

  // Relations
  product           products                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vendor            vendors                 @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  cart_items        cart_items[]
  order_items       order_items[]
  option_values     variant_option_values[]
  vendorSettings    vendor_settings?        @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?
}

model product_attributes {
  id         Int      @id @default(autoincrement())
  product_id Int
  name       String
  value      String
  position   Int      @default(0)
  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model product_options {
  id         Int                     @id @default(autoincrement())
  product_id Int
  name       String
  position   Int                     @default(0)
  product    products                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  values     product_option_values[]

  @@index([product_id])
}

model product_option_values {
  id        Int                     @id @default(autoincrement())
  option_id Int
  value     String
  position  Int                     @default(0)
  option    product_options         @relation(fields: [option_id], references: [id], onDelete: Cascade)
  variants  variant_option_values[]

  @@index([option_id])
}

model variant_option_values {
  variant_id      Int
  option_value_id Int
  variant         product_variants      @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  option_value    product_option_values @relation(fields: [option_value_id], references: [id], onDelete: Cascade)

  @@id([variant_id, option_value_id])
  @@index([option_value_id])
}

// ===============================================
// SHOPPING CART & WISHLISTS
// ===============================================

model carts {
  id          Int       @id @default(autoincrement())
  user_id     Int       @unique
  total_items Int       @default(0)
  subtotal    Decimal   @default(0) @db.Decimal(10, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  user  users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items cart_items[]
}

model cart_items {
  id          Int       @id @default(autoincrement())
  cart_id     Int
  product_id  Int
  variant_id  Int?
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  currency_id Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  cart     carts             @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product  products          @relation(fields: [product_id], references: [id])
  variant  product_variants? @relation(fields: [variant_id], references: [id])
  currency currencies?       @relation(fields: [currency_id], references: [id])

  @@index([variant_id])
}

model wishlist_items {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())

  // Relations
  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id]) // Keeps entries unique per user
  @@map("wishlist_items")
}

// ===============================================
// ORDERS & PAYMENTS
// ===============================================

model orders {
  id                     Int       @id @default(autoincrement())
  currency_id            Int
  user_id                Int
  order_number           String    @unique
  subtotal               Decimal   @db.Decimal(10, 2)
  shipping_fee           Decimal   @default(0) @db.Decimal(10, 2)
  tax                    Decimal   @default(0) @db.Decimal(10, 2)
  discount               Decimal   @default(0) @db.Decimal(10, 2)
  total                  Decimal   @db.Decimal(10, 2)
  note                   String?
  coupon_id              Int?
  coupon_code            String?
  status                 String    @default("pending")
  payment_status         String    @default("unpaid")
  payment_method         String?
  shipping_address       Json?
  billing_address        Json?
  checkout_key           String?
  checkout_hash          String?
  contact_email          String?
  reservation_expires_at DateTime? @default(dbgenerated("(now() + interval '30 minutes')"))
  created_at             DateTime  @default(now())
  updated_at             DateTime? @updatedAt

  // Relations
  user                  users                   @relation(fields: [user_id], references: [id])
  coupon                coupons?                @relation(fields: [coupon_id], references: [id])
  items                 order_items[]
  vendor_fulfillments   vendor_order_fulfillments[]
  marketplace_ledger_entries marketplace_ledger_entries[]
  payments              payments[]
  shipments             shipments[]
  returns               returns[]
  shipping_addresses    shipping_addresses[]
  currency              currencies?             @relation(fields: [currency_id], references: [id])
  coupon_usage          coupon_usage?
  status_history        order_status_history[]
  checkout_notification checkout_notifications?

  @@unique([user_id, checkout_key])
  @@index([user_id, status])
  @@index([created_at])
  @@index([coupon_id])
}

model vendor_order_fulfillments {
  id         Int       @id @default(autoincrement())
  order_id   Int
  vendor_id  Int
  status     String    @default("pending")
  gross_amount Decimal @default(0) @db.Decimal(10, 2)
  commission_rate Decimal @default(0) @db.Decimal(5, 2)
  commission_amount Decimal @default(0) @db.Decimal(10, 2)
  net_amount Decimal @default(0) @db.Decimal(10, 2)
  payout_status String @default("held")
  created_at DateTime  @default(now())
  updated_at DateTime?

  order  orders  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  vendor vendors @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  history vendor_order_fulfillment_history[]
  ledger_entries marketplace_ledger_entries[]

  @@unique([order_id, vendor_id])
  @@index([vendor_id, status])
}

model vendor_order_fulfillment_history {
  id             Int      @id @default(autoincrement())
  fulfillment_id Int
  status         String
  note           String?
  changed_by     Int?
  created_at     DateTime @default(now())

  fulfillment vendor_order_fulfillments @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade)

  @@index([fulfillment_id, created_at, id])
}

model platform_commission_settings {
  id           Int      @id @default(1) @db.SmallInt
  product_rate Decimal  @default(0) @db.Decimal(5, 2)
  service_rate Decimal  @default(0) @db.Decimal(5, 2)
  updated_by   Int?
  updated_at   DateTime @default(now())

  updater users? @relation("CommissionSettingsUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
}

model platform_commission_settings_history {
  id           Int      @id @default(autoincrement())
  product_rate Decimal  @db.Decimal(5, 2)
  service_rate Decimal  @db.Decimal(5, 2)
  changed_by   Int?
  created_at   DateTime @default(now())

  actor users? @relation("CommissionHistoryActor", fields: [changed_by], references: [id], onDelete: SetNull)
}

model marketplace_ledger_entries {
  id              BigInt   @id @default(autoincrement())
  vendor_id       Int?
  order_id        Int?
  fulfillment_id  Int?
  booking_id      Int?
  currency_id     Int
  entry_type      String
  amount          Decimal  @db.Decimal(10, 2)
  idempotency_key String   @unique
  metadata        Json?
  created_at      DateTime @default(now())

  vendor     vendors?                    @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  order      orders?                     @relation(fields: [order_id], references: [id], onDelete: Restrict)
  fulfillment vendor_order_fulfillments? @relation(fields: [fulfillment_id], references: [id], onDelete: Restrict)
  booking    service_bookings?           @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  currency   currencies                   @relation(fields: [currency_id], references: [id], onDelete: Restrict)

  @@index([vendor_id, created_at, id])
  @@index([order_id])
  @@index([booking_id])
}

model order_items {
  id             Int       @id @default(autoincrement())
  order_id       Int       @map("order_id")
  product_id     Int?      @map("product_id") // Nullable if the line is a service
  service_id     Int?      @map("service_id") // Nullable if the line is a product
  variant_id     Int?      @map("variant_id") // Nullable if no product variant exists
  vendor_id      Int       @map("vendor_id")
  quantity       Int
  stock_reserved Boolean   @default(false)
  price          Decimal   @db.Decimal(10, 2)
  subtotal       Decimal   @db.Decimal(10, 2)
  created_at     DateTime  @default(now()) @map("created_at")
  updated_at     DateTime? @updatedAt @map("updated_at")

  // 🌟 Cleaned, Compilable Relations
  order             orders            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           products?         @relation(fields: [product_id], references: [id]) // Made optional
  service           services?         @relation(fields: [service_id], references: [id]) // Corrected single mapping
  variant           product_variants? @relation(fields: [variant_id], references: [id])
  vendor            vendors           @relation(fields: [vendor_id], references: [id])
  return_items      return_items[]
  vendorSettings    vendor_settings?  @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  // Performance Compound Indexes
  @@index([order_id])
  @@index([product_id])
  @@index([service_id])
  @@index([variant_id])
  @@index([vendor_id])
  @@map("order_items")
}

model shipping_addresses {
  country_id Int?
  id         Int       @id @default(autoincrement())
  order_id   Int?
  user_id    Int
  firstname  String
  lastname   String
  phone_one  String
  phone_two  String?
  address    String
  city       String
  state      String
  country    String
  zip_code   String?
  is_default Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  user   users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders orders? @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model payments {
  booking_id Int? @unique
  booking service_bookings? @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  events             payment_events[]
  provider_ref       String?          @unique
  checkout_data      String?
  initializing_until DateTime?
  paid_at            DateTime?
  id                 Int              @id @default(autoincrement())
  order_id           Int?
  user_id            Int
  vendor_id          Int?
  gateway            String // paystack, stripe, etc
  gateway_ref        String           @unique
  amount             Decimal          @db.Decimal(10, 2)
  currency_id        Int
  status             String           @default("pending") // pending, completed, failed
  meta               String? // JSON metadata
  created_at         DateTime         @default(now())
  updated_at         DateTime?        @updatedAt

  // Relations
  order             orders?          @relation(fields: [order_id], references: [id])
  user              users            @relation(fields: [user_id], references: [id])
  vendor            vendors?         @relation(fields: [vendor_id], references: [id])
  vendorSettings    vendor_settings? @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?
}

model coupons {
  usage        coupon_usage[]
  id           Int            @id @default(autoincrement())
  vendor_id    Int
  product_id   Int?
  service_id   Int?
  code         String
  type         String // percentage, fixed_amount
  value        Decimal        @db.Decimal(10, 2)
  max_discount Decimal?       @db.Decimal(10, 2)
  min_order    Decimal        @default(0) @db.Decimal(10, 2)
  usage_limit  Int?
  usage_count  Int            @default(0)
  status       String         @default("active")
  expires_at   DateTime?
  description  String?
  created_at   DateTime       @default(now())
  updated_at   DateTime?      @updatedAt

  // Relations
  vendor            vendors          @relation(fields: [vendor_id], references: [id])
  product           products?        @relation(fields: [product_id], references: [id])
  service           services?        @relation(fields: [service_id], references: [id])
  orders            orders[]
  vendorSettings    vendor_settings? @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  @@unique([vendor_id, code])
  @@index([status, expires_at])
}

// ===============================================
// SHIPMENTS & RETURNS
// ===============================================

model shipments {
  id                 Int       @id @default(autoincrement())
  order_id           Int
  vendor_id          Int?
  vendor             vendors? @relation(fields: [vendor_id], references: [id])
  tracking_number    String?
  carrier            String?
  shipping_method    String?
  estimated_delivery DateTime?
  actual_delivery    DateTime?
  shipping_cost      Decimal   @default(0) @db.Decimal(10, 2)
  status             String    @default("pending") // pending, processing, shipped, in_transit, delivered
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime? @updatedAt

  // Relations
  order            orders                      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  tracking_history shipment_tracking_history[]

  @@unique([order_id, vendor_id])
  @@index([vendor_id])
}

model shipment_tracking_history {
  changed_by Int?
  id          Int       @id @default(autoincrement())
  shipment_id Int
  status      String
  location    String?
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  shipment shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@index([shipment_id, created_at, id])
}

model returns {
  id            Int       @id @default(autoincrement())
  order_id      Int
  user_id       Int
  vendor_id     Int?
  reason        String
  description   String?
  return_type   String // full, partial, exchange
  refund_amount Decimal   @default(0) @db.Decimal(10, 2)
  status        String    @default("pending") // pending, approved, rejected, shipped, received, completed
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  vendor_notes String?
  admin_notes  String?
  evidence     Json?
  approved_at  DateTime?
  completed_at DateTime?

  // Relations
  order             orders           @relation(fields: [order_id], references: [id])
  user              users            @relation(fields: [user_id], references: [id])
  vendor            vendors?         @relation(fields: [vendor_id], references: [id])
  items             return_items[]
  vendorSettings    vendor_settings? @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?
}

model return_items {
  id            Int       @id @default(autoincrement())
  return_id     Int
  order_item_id Int
  quantity      Int
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt

  condition String?

  // Relations
  return     returns     @relation(fields: [return_id], references: [id], onDelete: Cascade)
  order_item order_items @relation(fields: [order_item_id], references: [id])

  @@index([order_item_id])
}

// ===============================================
// REVIEWS & RATINGS
// ===============================================

model reviews {
  id                Int       @id @default(autoincrement())
  product_id        Int?
  service_id        Int?
  user_id           Int
  order_id          Int?
  booking_id        Int?
  revision          Int       @default(1)
  moderation_note   String?
  rating            Int       @default(5)
  title             String?
  comment           String?
  status            String    @default("pending") // pending, approved, rejected
  verified_purchase Boolean   @default(false)
  helpful_count     Int       @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt

  // Relations
  product products? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  service services? @relation(fields: [service_id], references: [id], onDelete: Cascade)
  user    users     @relation(fields: [user_id], references: [id])
  booking service_bookings? @relation(fields: [booking_id], references: [id], onDelete: SetNull)

  @@unique([user_id, product_id])
  @@unique([user_id, service_id])
  @@index([product_id, status, id])
  @@index([service_id, status, id])
  @@index([status, id])
}

// ===============================================
// SUPPORT & NOTIFICATIONS
// ===============================================

model support_tickets {
  id                     Int       @id @default(autoincrement())
  ticket_number          String    @unique
  subject                String
  category               String?
  priority               String    @default("medium") // low, medium, high
  status                 String    @default("open") // open, in_progress, waiting_on_user, resolved
  assigned_to            Int?
  pending_assigned_to    Int?
  transfer_requested_by  Int?
  transfer_requested_at  DateTime?
  assignee               users?    @relation("SupportAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  pending_assignee       users?    @relation("SupportTransferTarget", fields: [pending_assigned_to], references: [id], onDelete: SetNull)
  transfer_requester     users?    @relation("SupportTransferRequester", fields: [transfer_requested_by], references: [id], onDelete: SetNull)
  user_id                Int?
  vendor_id              Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime? @updatedAt

  // Relations
  user              users?                   @relation(fields: [user_id], references: [id])
  vendor            vendors?                 @relation(fields: [vendor_id], references: [id])
  replies           support_ticket_replies[]
  vendorSettings    vendor_settings?         @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  @@index([user_id, created_at])
  @@index([assigned_to, status])
  @@index([pending_assigned_to])
}

model support_ticket_replies {
  id          Int       @id @default(autoincrement())
  ticket_id   Int
  user_id     Int
  message     String?
  attachment  String?
  is_internal Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  ticket support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   users           @relation(fields: [user_id], references: [id])

  @@index([ticket_id, id])
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String // order, payment, return, shipment, etc
  title      String
  message    String
  metadata   String? // JSON data
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, id])
  @@index([user_id, read_at])
}

model activity_logs {
  id         Int      @id @default(autoincrement())
  user_id    Int
  action     String
  details    String? // JSON data
  created_at DateTime @default(now())

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ===============================================
// SETTINGS
// ===============================================

model vendor_settings {
  id                   Int       @id @default(autoincrement())
  vendor_id            Int       @unique
  user_id              Int       @unique
  store_name           String?
  store_slug           String?   @unique
  description          String?
  logo                 String?
  banner               String?
  phone_one            String?
  phone_two            String?
  facebook             String?
  twitter              String?
  instagram            String?
  linkedIn             String?
  snapchat             String?
  whatsapp             String?
  email                String?
  website              String?
  address              String?
  city                 String?
  state                String?
  postal_code          String?
  country_id           Int?
  terms_and_conditions String?
  privacy_policy       String?
  created_at           DateTime  @default(now())
  updated_at           DateTime? @updatedAt

  // Relations
  vendor vendors @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  // Relations
  user             users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products         products[]
  order_items      order_items[]
  product_images   product_images[]
  product_variants product_variants[]
  payments         payments[]
  coupons          coupons[]
  support_tickets  support_tickets[]
  returns          returns[]
  admins           admins[]
  admin_audit_logs admin_audit_logs[]
  service_bookings service_bookings[]

  @@index([country_id])
}

// ===============================================
// REFERENCE DATA
// ===============================================

model countries {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  currency_id Int
  status      Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt

  // Relations
  users    users[]
  currency currencies @relation(fields: [currency_id], references: [id], onDelete: Cascade)
}

model currencies {
  orders     orders[]
  marketplace_ledger_entries marketplace_ledger_entries[]
  id         Int       @id @default(autoincrement())
  code       String    @unique
  name       String
  status     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  // Relations
  products  products[]
  countries countries[]
  cartItems cart_items[]
  services  services[]
}

model services {
  id            Int       @id @default(autoincrement())
  vendor_id     Int       @map("vendor_id")
  name          String
  slug          String    @unique
  description   String?
  base_price    Decimal   @map("base_price") @db.Decimal(10, 2)
  currency_id   Int       @map("currency_id")
  duration_mins Int       @default(60) @map("duration_mins")
  status        String    @default("active") // active, paused, deleted
  created_at    DateTime  @default(now()) @map("created_at")
  updated_at    DateTime? @updatedAt @map("updated_at")

  // Relations
  vendor                    vendors            @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  orderItems                order_items[]
  bookings                  service_bookings[]
  packages                  service_packages[]
  reviews                   reviews[]
  currency                  currencies         @relation(fields: [currency_id], references: [id], onDelete: Cascade)
  coupons                   coupons[]
  category_id               Int?
  subcategory_id            Int?
  childcategory_id          Int?
  short_description         String?
  tags                      String[]           @default([])
  compare_at_price          Decimal?           @db.Decimal(10, 2)
  buffer_mins               Int                @default(0)
  max_bookings_per_slot     Int                @default(1)
  is_remote                 Boolean            @default(false)
  location_type             String             @default("vendor_location")
  cancellation_window_hours Int                @default(24)
  cancellation_fee_percent  Float              @default(0)
  images                    String[]           @default([])
  thumbnail                 String?
  meta_title                String?
  meta_description          String?
  deleted_at                DateTime?

  category          categories?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  subcategory       subcategories?   @relation(fields: [subcategory_id], references: [id], onDelete: SetNull)
  childcategory     childcategories? @relation(fields: [childcategory_id], references: [id], onDelete: SetNull)

  @@index([vendor_id, status])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([childcategory_id])
  @@map("services")
}

model PlanVersion {
  id                       Int             @id @default(autoincrement())
  plan                     SubscriptionPlan
  version                  Int
  priceNaira               Decimal         @map("price_naira") @db.Decimal(12, 2)
  commissionPercent        Decimal         @map("commission_percent") @db.Decimal(5, 2)
  activeServices           Int?            @map("active_services")
  packagesPerService       Int             @map("packages_per_service")
  portfolioImages          Int             @map("portfolio_images")
  promotedSlotsPerMonth    Int             @map("promoted_slots_per_month")
  analytics                PlanAnalytics
  support                  PlanSupport
  isCurrent                Boolean         @default(false) @map("is_current")
  paystackPlanCode         String?         @map("paystack_plan_code")
  createdAt                DateTime        @default(now()) @map("created_at")

  subscriptions        Subscription[] @relation("SubscriptionCurrentPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")
  events               SubscriptionEvent[]

  @@unique([plan, version])
  @@index([plan, isCurrent])
  @@map("plan_versions")
}

model PaystackWebhookEvent {
  id               BigInt    @id @default(autoincrement())
  eventKey         String    @unique @map("event_key")
  eventType        String    @map("event_type")
  reference        String?
  transactionId    String?   @map("transaction_id")
  subscriptionCode String?   @map("subscription_code")
  customerCode     String?   @map("customer_code")
  eventStatus      String?   @map("event_status")
  status           String    @default("pending")
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at")
  processingUntil  DateTime? @map("processing_until")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  processedAt      DateTime? @map("processed_at")

  @@index([status, availableAt, createdAt])
  @@map("paystack_webhook_events")
}

model SubscriptionRenewalEmail {
  id                BigInt    @id @default(autoincrement())
  eventKey          String    @unique @map("event_key")
  providerId        Int       @map("provider_id")
  userId            Int       @map("user_id")
  recipientEmail    String    @map("recipient_email")
  firstname         String?
  currentPeriodEnd  DateTime  @map("current_period_end")
  pendingPlan       SubscriptionPlan? @map("pending_plan")
  status            String    @default("pending")
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now()) @map("available_at")
  processingUntil   DateTime? @map("processing_until")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  sentAt            DateTime? @map("sent_at")

  @@index([status, availableAt, createdAt])
  @@map("subscription_renewal_emails")
}

model service_packages {
  id            Int       @id @default(autoincrement())
  service_id    Int
  name          String
  description   String?
  price         Decimal   @db.Decimal(10, 2)
  duration_mins Int       @default(60)
  status        String    @default("active")
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  deleted_at    DateTime?

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id, deleted_at])
  @@map("service_packages")
}

model Subscription {
  id                       Int                @id @default(autoincrement())
  providerId               Int                @unique @map("provider_id")
  plan                     SubscriptionPlan
  planVersion              Int?               @map("plan_version")
  status                   SubscriptionStatus
  currentPeriodStart       DateTime?          @map("current_period_start")
  currentPeriodEnd         DateTime?          @map("current_period_end")
  graceEndsAt              DateTime?          @map("grace_ends_at")
  cancelAtPeriodEnd        Boolean            @default(false) @map("cancel_at_period_end")
  pendingPlan              SubscriptionPlan?  @map("pending_plan")
  pendingPlanVersion       Int?               @map("pending_plan_version")
  trialUsed                Boolean            @default(false) @map("trial_used")
  paystackCustomerCode     String?            @map("paystack_customer_code")
  paystackSubscriptionCode String?            @map("paystack_subscription_code")
  paystackEmailToken       String?            @map("paystack_email_token")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  provider          vendors      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planDefinition    PlanVersion? @relation("SubscriptionCurrentPlan", fields: [plan, planVersion], references: [plan, version], onDelete: Restrict)
  pendingDefinition PlanVersion? @relation("SubscriptionPendingPlan", fields: [pendingPlan, pendingPlanVersion], references: [plan, version], onDelete: Restrict)
  events            SubscriptionEvent[]

  @@index([status, currentPeriodEnd])
  @@index([status, graceEndsAt])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             Int          @id @default(autoincrement())
  subscriptionId Int?         @map("subscription_id")
  providerId     Int?         @map("provider_id")
  planVersionId  Int?         @map("plan_version_id")
  type           String
  eventKey       String?      @unique @map("event_key")
  meta           Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider     vendors?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  planVersion  PlanVersion?  @relation(fields: [planVersionId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model service_bookings {
  payment payments?
  ledger_entries marketplace_ledger_entries[]
  reviews reviews[]
  id                        Int       @id @default(autoincrement())
  service_id                Int       @map("service_id")
  vendor_id                 Int       @map("vendor_id")
  user_id                   Int       @map("user_id")
  currency_id               Int       @map("currency_id")
  service_name              String
  total                     Decimal?  @db.Decimal(10, 2)
  commission_rate           Decimal   @default(0) @db.Decimal(5, 2)
  commission_amount         Decimal   @default(0) @db.Decimal(10, 2)
  vendor_amount             Decimal   @default(0) @db.Decimal(10, 2)
  payment_method            String
  payment_status            String    @default("unpaid") // unpaid, paid, refunded
  ends_at                   DateTime?
  buffer_mins               Int       @default(0) @map("buffer_mins")
  location_type             String
  location                  String    @map("location")
  checkout_key              String    @map("checkout_key")
  checkout_hash             String    @map("checkout_hash")
  scheduled_for             DateTime  @map("scheduled_for")
  cancellation_window_hours Int       @default(24) @map("cancellation_window_hours")
  cancellation_fee_percent  Float     @default(0) @map("cancellation_fee_percent")
  reservation_expires_at    DateTime? @default(dbgenerated("(now() + interval '24 hours')")) @map("reservation_expires_at")
  created_at                DateTime  @default(now()) @map("created_at")
  booking_status            String    @default("pending") @map("booking_status") // pending, accepted, declined, confirmed, active, completed, cancelled, expired, payment_review
  note                      String?   @map("note")
  vendor_response_note      String?
  proposed_scheduled_for    DateTime? @db.Timestamptz(3)
  proposed_ends_at          DateTime? @db.Timestamptz(3)

  // Relations
  service           services         @relation(fields: [service_id], references: [id]) // Linked safely here
  user              users            @relation(fields: [user_id], references: [id])
  vendors           vendors          @relation(fields: [vendor_id], references: [id])
  vendorSettings    vendor_settings? @relation(fields: [vendor_settingsId], references: [id])
  vendor_settingsId Int?

  @@index([service_id, booking_status])
  @@map("service_bookings")
}

model coupon_usage {
  coupon    coupons @relation(fields: [coupon_id], references: [id])
  user      users   @relation(fields: [user_id], references: [id])
  order     orders  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  id        Int     @id @default(autoincrement())
  coupon_id Int
  user_id   Int
  order_id  Int     @unique

  @@unique([coupon_id, user_id])
}

model order_status_history {
  id         Int      @id @default(autoincrement())
  order_id   Int
  status     String
  note       String?
  changed_by Int?
  created_at DateTime @default(now())

  order           orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  changed_by_user users? @relation(fields: [changed_by], references: [id])

  @@index([order_id, created_at])
}

model payment_events {
  payment          payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  id               Int      @id @default(autoincrement())
  payment_id       Int
  gateway          String
  gateway_event_id String
  event_type       String
  created_at       DateTime @default(now())

  @@unique([gateway, gateway_event_id])
}

model checkout_notifications {
  id           Int       @id @default(autoincrement())
  order_id     Int       @unique
  attempts     Int       @default(0)
  available_at DateTime  @default(now())
  delivered_at DateTime?

  order orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model faq {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  question   String
  answer     String
  status     Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime?
}
